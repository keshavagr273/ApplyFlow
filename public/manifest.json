{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "identity",
    "webNavigation",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "oauth2": {
    "client_id": "106618788934-7jo01eofmkp9pe73selaanlko4r6ickl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["src/content/clipper.ts"],
      "matches": ["*://*/*"],
      "run_at": "document_end",
      "exclude_matches": [
        "*://chrome.google.com/webstore/*"
      ]
    },
    {
      "js": ["src/content/fab.ts"],
      "matches": ["*://*/*"],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://chrome.google.com/webstore/*"
      ]
    },
    {
      "js": ["src/content/overlay.ts"],
      "matches": ["*://*/*"],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://chrome.google.com/webstore/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/widget.css",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
